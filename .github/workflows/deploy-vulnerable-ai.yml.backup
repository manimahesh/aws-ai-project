name: Deploy Vulnerable AI Infrastructure

on:
  workflow_dispatch:
    inputs:
      action:
        description: 'Action to perform'
        required: true
        default: 'apply'
        type: choice
        options:
          - apply
          - destroy
      aws_region:
        description: 'AWS Region'
        required: false
        default: 'us-west-2'

env:
  TF_VERSION: '1.6.0'
  AWS_REGION: ${{ github.event.inputs.aws_region || 'us-west-2' }}

jobs:
  terraform:
    name: Terraform ${{ github.event.inputs.action }}
    runs-on: ubuntu-latest

    permissions:
      id-token: write
      contents: read

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Create terraform.tfvars
        run: |
          cat > terraform/terraform.tfvars <<EOF
          aws_region = "${{ env.AWS_REGION }}"
          project_name = "vulnerable-ai-demo"
          instance_type = "t3.xlarge"
          ssh_public_key = "${{ secrets.SSH_PUBLIC_KEY }}"
          EOF

      - name: Terraform Init
        working-directory: ./terraform
        run: terraform init

      - name: Terraform Validate
        working-directory: ./terraform
        run: terraform validate

      - name: Terraform Plan
        if: github.event.inputs.action == 'apply'
        working-directory: ./terraform
        run: terraform plan -out=tfplan

      - name: Terraform Apply
        if: github.event.inputs.action == 'apply'
        working-directory: ./terraform
        run: terraform apply -auto-approve tfplan

      - name: Get EC2 Instance ID
        if: github.event.inputs.action == 'apply'
        id: get_instance
        working-directory: ./terraform
        run: |
          INSTANCE_ID=$(terraform output -raw ec2_instance_id || echo "")
          echo "instance_id=$INSTANCE_ID" >> $GITHUB_OUTPUT
          PUBLIC_IP=$(terraform output -raw ec2_public_ip || echo "")
          echo "public_ip=$PUBLIC_IP" >> $GITHUB_OUTPUT

      - name: Wait for EC2 to be running
        if: github.event.inputs.action == 'apply' && steps.get_instance.outputs.instance_id != ''
        run: |
          aws ec2 wait instance-running --instance-ids ${{ steps.get_instance.outputs.instance_id }}
          echo "Instance is running, waiting 30 seconds for initialization..."
          sleep 30

      - name: Configure EC2 Instance
        if: github.event.inputs.action == 'apply' && steps.get_instance.outputs.public_ip != ''
        uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ steps.get_instance.outputs.public_ip }}
          username: ubuntu
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script_stop: false
          command_timeout: 30m
          script: |
            set -e

            # Update system
            sudo apt-get update
            sudo DEBIAN_FRONTEND=noninteractive apt-get upgrade -y

            # Install dependencies
            sudo apt-get install -y curl wget git nodejs npm python3 python3-pip jq awscli

            # Install yt-dlp for YouTube video processing
            sudo pip3 install yt-dlp youtube-transcript-api

            # Install Ollama
            curl -fsSL https://ollama.com/install.sh | sh

            # Configure Ollama to listen on all interfaces (INSECURE - for demonstration)
            sudo mkdir -p /etc/systemd/system/ollama.service.d
            sudo tee /etc/systemd/system/ollama.service.d/override.conf > /dev/null <<EOF
            [Service]
            Environment="OLLAMA_HOST=0.0.0.0:11434"
            EOF

            # Restart Ollama with new configuration
            sudo systemctl daemon-reload
            sudo systemctl restart ollama
            sudo systemctl enable ollama

            # Wait for Ollama to start
            sleep 10

            # Pull Llama 3.2 model
            ollama pull llama3.2

            echo "EC2 instance configuration completed successfully"

      - name: Deploy Application
        if: github.event.inputs.action == 'apply' && steps.get_instance.outputs.public_ip != ''
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ steps.get_instance.outputs.public_ip }}
          username: ubuntu
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          source: "app/*"
          target: "/tmp/app"

      - name: Install and Start Application
        if: github.event.inputs.action == 'apply' && steps.get_instance.outputs.public_ip != ''
        uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ steps.get_instance.outputs.public_ip }}
          username: ubuntu
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            # Create application directory
            sudo mkdir -p /var/www/vulnerable-ai-app

            # Copy application files
            sudo cp -r /tmp/app/* /var/www/vulnerable-ai-app/

            # Get S3 bucket name from Terraform
            S3_BUCKET="${{ steps.get_s3_bucket.outputs.bucket_name }}"

            # Update server.js with actual S3 bucket name
            sudo sed -i "s/REPLACE_WITH_S3_BUCKET/$S3_BUCKET/g" /var/www/vulnerable-ai-app/server.js

            # Create systemd service
            sudo tee /etc/systemd/system/vulnerable-ai-app.service > /dev/null <<'SERVICEEOF'
            [Unit]
            Description=Vulnerable AI Application (Security Training)
            After=network.target ollama.service

            [Service]
            Type=simple
            User=root
            WorkingDirectory=/var/www/vulnerable-ai-app
            ExecStart=/usr/bin/node /var/www/vulnerable-ai-app/server.js
            Restart=always
            RestartSec=10
            Environment=NODE_ENV=production

            [Install]
            WantedBy=multi-user.target
            SERVICEEOF

            # Set permissions
            sudo chmod +x /var/www/vulnerable-ai-app/server.js

            # Enable and start the service
            sudo systemctl daemon-reload
            sudo systemctl enable vulnerable-ai-app
            sudo systemctl start vulnerable-ai-app

            # Create status check script
            sudo tee /root/check-status.sh > /dev/null <<'STATUSEOF'
            #!/bin/bash
            echo "=== Vulnerable AI Application Status ==="
            echo ""
            echo "Ollama Status:"
            systemctl status ollama --no-pager | grep Active
            echo ""
            echo "Ollama Models:"
            ollama list
            echo ""
            echo "Web Application Status:"
            systemctl status vulnerable-ai-app --no-pager | grep Active
            echo ""
            echo "Open Ports:"
            netstat -tlnp | grep -E ':(80|11434)'
            echo ""
            echo "Recent Application Logs:"
            journalctl -u vulnerable-ai-app -n 20 --no-pager
            STATUSEOF

            sudo chmod +x /root/check-status.sh

            echo "Application deployed successfully!"

      - name: Get S3 Bucket Name
        if: github.event.inputs.action == 'apply'
        id: get_s3_bucket
        working-directory: ./terraform
        run: |
          BUCKET_NAME=$(terraform output -raw s3_bucket_name || echo "")
          echo "bucket_name=$BUCKET_NAME" >> $GITHUB_OUTPUT

      - name: Output Deployment Info
        if: github.event.inputs.action == 'apply'
        run: |
          echo "## Deployment Complete! 🚀" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### Access Information" >> $GITHUB_STEP_SUMMARY
          echo "- **Web Application**: http://${{ steps.get_instance.outputs.public_ip }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Ollama API**: http://${{ steps.get_instance.outputs.public_ip }}:11434" >> $GITHUB_STEP_SUMMARY
          echo "- **SSH**: \`ssh -i ~/.ssh/your-key ubuntu@${{ steps.get_instance.outputs.public_ip }}\`" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### S3 Bucket" >> $GITHUB_STEP_SUMMARY
          echo "- **Name**: ${{ steps.get_s3_bucket.outputs.bucket_name }}" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "### ⚠️ Security Warning" >> $GITHUB_STEP_SUMMARY
          echo "This is an INTENTIONALLY VULNERABLE environment for training purposes only!" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Wait 5-10 minutes for Ollama model download to complete before testing." >> $GITHUB_STEP_SUMMARY

      - name: Terraform Destroy
        if: github.event.inputs.action == 'destroy'
        working-directory: ./terraform
        run: terraform destroy -auto-approve
